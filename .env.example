# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Environment: "dev" | "prod". In "dev" verification codes are printed to the
# console instead of being sent over a real email/SMS provider.
ENVIRONMENT=dev
DEBUG=true
PROJECT_NAME=Users API

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Async SQLAlchemy URL. For local Docker Compose use the "db" host.
# PostgreSQL example: postgresql+asyncpg://users_api:users_api@db:5432/users_api
# SQLite example (no server needed): sqlite+aiosqlite:///./users_api.db
DATABASE_URL=postgresql+asyncpg://users_api:users_api@db:5432/users_api

# ---------------------------------------------------------------------------
# Security / JWT
# ---------------------------------------------------------------------------
# Generate a strong secret, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Verification
# ---------------------------------------------------------------------------
# How long a verification code stays valid (minutes) and after how many hours
# an unverified account is purged by the cleanup task.
VERIFICATION_CODE_TTL_MINUTES=60
UNVERIFIED_ACCOUNT_TTL_HOURS=48

# ---------------------------------------------------------------------------
# Celery / Redis
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------------------------------------------------------------------------
# First admin (created on startup if it does not exist). Optional but handy.
# ---------------------------------------------------------------------------
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin12345!
